PKG_CPPFLAGS = -DTMBAD_FRAMEWORK
PKG_CXXFLAGS += -Wa,-mbig-obj

all: $(SHLIB) precompile_templates

precompile_templates:
	"$(R_HOME)/bin$(R_ARCH_BIN)/Rscript.exe" -e "library(TMB); cleanup <- function(dir, pattern) { stale <- list.files(dir, pattern=pattern, full.names=TRUE); if (length(stale) > 0L) { unlink(stale, force=TRUE); left <- stale[file.exists(stale)]; if (length(left) > 0L) stop('Failed to remove stale files: ', paste(basename(left), collapse=', ')); } }; src <- normalizePath(getwd(), winslash='/'); tmb_dir <- file.path(src, 'tmb'); out_dir <- file.path(src, '..', 'inst', 'tmb'); dir.create(out_dir, recursive=TRUE, showWarnings=FALSE); cleanup(tmb_dir, '[.](o|obj|dll|def)$$'); cleanup(out_dir, '[.](dll|so|dylib)$$'); old <- getwd(); on.exit(setwd(old), add=TRUE); setwd(tmb_dir); files <- c('intCPUE_w000.cpp','intCPUE_w100.cpp','intCPUE_w010.cpp','intCPUE_w110.cpp','intCPUE_w001.cpp','intCPUE_w101.cpp','intCPUE_w011.cpp','intCPUE_w111.cpp'); for (f in files) { stem <- tools::file_path_sans_ext(basename(f)); cleanup('.', paste0('^', stem, '[.](o|obj|dll|def)$$')); compile(f, flags='-Wa,-mbig-obj', openmp=TRUE, framework='TMBad'); }; dynext <- get('.Platform')[['dynlib.ext']]; dlls <- list.files(tmb_dir, pattern=paste0('[.]', sub('^[.]', '', dynext), '$$'), full.names=TRUE); if (length(dlls) != length(files)) stop('Expected ', length(files), ' template DLLs but found ', length(dlls), '.'); copied <- file.copy(dlls, out_dir, overwrite=TRUE); if (!all(copied)) stop('Failed to copy one or more template DLLs into inst/tmb.')"
